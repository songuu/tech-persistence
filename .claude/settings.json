{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(.claude/**)",
      "Write(docs/tech-learnings/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Administrator/.claude/skills/continuous-learning/hooks/inject-context.js\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Administrator/.claude/skills/continuous-learning/hooks/observe.js\" pre || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Administrator/.claude/skills/continuous-learning/hooks/observe.js\" post || true",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Administrator/.claude/skills/continuous-learning/hooks/evaluate-session.js\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Administrator/.claude/skills/continuous-learning/hooks/prompt-submit.js\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
