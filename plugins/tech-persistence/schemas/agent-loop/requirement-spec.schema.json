{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-persistence.local/schemas/agent-loop/requirement-spec.schema.json",
  "title": "Agent Loop Requirement Spec",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "requirementSpec",
    "technicalDesign",
    "taskBreakdown",
    "assumptions",
    "outOfScope",
    "humanReviewChecklist"
  ],
  "properties": {
    "requirementSpec": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "summary",
        "userValue",
        "scope",
        "acceptanceCriteria"
      ],
      "properties": {
        "summary": { "type": "string" },
        "userValue": { "type": "string" },
        "scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "acceptanceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "technicalDesign": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "approach",
        "files",
        "risks",
        "testStrategy"
      ],
      "properties": {
        "approach": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "interfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dataAndState": { "type": "string" },
        "risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "testStrategy": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": true }
          ]
        }
      }
    },
    "taskBreakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title",
          "description",
          "dependencies",
          "risk",
          "criterionIds",
          "doneCriteria"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk": {
            "type": "string",
            "enum": ["L0", "L1", "L2", "L3", "L4"]
          },
          "criterionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/criterionId" }
          },
          "doneCriteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "suggestedValidation": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outOfScope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "humanReviewChecklist": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "criterionId": { "type": "string", "pattern": "^ac-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "procedure", "expected"],
      "properties": {
        "type": { "type": "string", "enum": ["command", "artifact", "readback", "independent-review", "user-confirmation"] },
        "procedure": { "type": "string", "minLength": 1, "description": "For artifact Oracle use artifact:<workdir-relative-path>; unsupported or unsafe locators remain unknown." },
        "expected": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "properties": { "type": { "const": "command" }, "expected": { "const": "exit code is zero" } } },
        { "properties": { "type": { "enum": ["artifact", "readback", "independent-review", "user-confirmation"] } } }
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "sourceRefs", "oracle"],
      "properties": {
        "id": { "$ref": "#/$defs/criterionId" },
        "statement": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "oracle": { "$ref": "#/$defs/oracle" }
      }
    }
  }
}
