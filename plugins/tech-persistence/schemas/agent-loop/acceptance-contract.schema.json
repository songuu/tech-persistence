{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-persistence.local/schemas/agent-loop/acceptance-contract.schema.json",
  "title": "Agent Loop Acceptance Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRequirementHash", "criteria", "contractHash"],
  "properties": {
    "schemaVersion": { "const": "acceptance-contract-v1" },
    "sourceRequirementHash": { "$ref": "#/$defs/hash" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "contractHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "criterionId": {
      "type": "string",
      "pattern": "^ac-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "procedure", "expected"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["command", "artifact", "readback", "independent-review", "user-confirmation"]
        },
        "procedure": { "type": "string", "minLength": 1, "description": "For artifact Oracle use artifact:<workdir-relative-path>; unsupported or unsafe locators remain unknown." },
        "expected": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "command" },
            "expected": { "const": "exit code is zero" }
          }
        },
        {
          "properties": {
            "type": { "enum": ["artifact", "readback", "independent-review", "user-confirmation"] }
          }
        }
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "sourceRefs", "oracle"],
      "properties": {
        "id": { "$ref": "#/$defs/criterionId" },
        "statement": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "oracle": { "$ref": "#/$defs/oracle" }
      }
    }
  }
}
