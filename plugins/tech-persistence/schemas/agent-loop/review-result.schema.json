{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-persistence.local/schemas/agent-loop/review-result.schema.json",
  "title": "Agent Loop Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "compliant",
    "findings",
    "followUpTasks"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["approved", "changes_requested", "blocked"]
    },
    "compliant": { "type": "boolean" },
    "summary": { "type": "string" },
    "criterionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ac-[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "message": { "type": "string", "minLength": 1 },
          "requiredFix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "followUpTasks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contractRevisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revisionId", "fields", "rationale"],
        "properties": {
          "revisionId": {
            "type": "string",
            "pattern": "^rev-[a-z0-9-]+$"
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "goal": { "type": "string", "minLength": 1 },
              "nonGoals": {
                "type": "array",
                "items": { "type": "string" }
              },
              "globalAcceptance": {
                "type": "array",
                "items": { "type": "string" }
              },
              "architectureConstraints": {
                "type": "array",
                "items": { "type": "string" }
              },
              "runtimeTargets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["claude-code", "codex"]
                }
              }
            },
            "anyOf": [
              { "required": ["goal"] },
              { "required": ["nonGoals"] },
              { "required": ["globalAcceptance"] },
              { "required": ["architectureConstraints"] },
              { "required": ["runtimeTargets"] }
            ]
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "clarificationRulings": {
      "type": "array",
      "description": "Optional. Rulings for open clarifications raised by the implementer. decision=confirm-assumption keeps the adopted assumption; decision=revise-spec means the spec must change (also surface the change in findings/followUpTasks so the classic needs-followup loop re-implements).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["confirm-assumption", "revise-spec"]
          },
          "note": { "type": "string" }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "decision": { "const": "approved" },
        "compliant": { "const": true },
        "findings": { "maxItems": 0 },
        "followUpTasks": { "maxItems": 0 },
        "contractRevisions": { "maxItems": 0 },
        "clarificationRulings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": { "const": "confirm-assumption" }
            }
          }
        }
      }
    },
    {
      "properties": {
        "decision": { "const": "changes_requested" },
        "compliant": { "const": false }
      }
    },
    {
      "properties": {
        "decision": { "const": "blocked" },
        "compliant": { "const": false }
      }
    }
  ]
}
