{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-persistence.local/schemas/agent-loop/task-envelope.schema.json",
  "title": "Dual Native Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "ref",
    "hash",
    "idempotencyKey",
    "runtimeRefs",
    "orchestrationOwner",
    "intent",
    "requiredCapabilities",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": "task-envelope-v1" },
    "kind": { "const": "task" },
    "ref": { "type": "string", "minLength": 1 },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^idem:[a-f0-9]{64}$"
    },
    "runtimeRefs": { "$ref": "#/$defs/runtimeRefs" },
    "orchestrationOwner": {
      "type": "string",
      "enum": ["tp", "codex-host", "claude-host"]
    },
    "intent": {
      "type": "string",
      "enum": ["read-only", "write"]
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "coordination": { "$ref": "#/$defs/coordination" },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskClass",
        "actionKind",
        "continuationPolicy",
        "successorRefs",
        "noFollowUp"
      ],
      "properties": {
        "taskClass": { "type": "string", "minLength": 1 },
        "actionKind": { "type": "string", "minLength": 1 },
        "continuationPolicy": {
          "type": "string",
          "enum": ["continue", "pause", "stop"]
        },
        "successorRefs": {
          "type": "array",
          "description": "Canonical task successor refs, emitted in unique sorted order.",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "noFollowUp": { "type": "boolean" },
        "claimedBy": {
          "type": "string",
          "minLength": 1,
          "description": "Visibility-only soft owner; it grants no route eligibility, permission, or write authority."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "noFollowUp": { "const": true } }
          },
          "then": {
            "properties": { "successorRefs": { "maxItems": 0 } }
          }
        }
      ]
    },
    "runtimeRefs": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "null"],
        "minLength": 1
      }
    }
  }
}
