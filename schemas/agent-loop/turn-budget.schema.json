{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-persistence.local/schemas/agent-loop/turn-budget.schema.json",
  "title": "Agent Loop Fixed Turn Budget Ledger",
  "description": "The authoritative append-only ledger for an optional fixed per-run turn budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "enabled",
    "maxSlots",
    "revision",
    "spends",
    "ledgerHash"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-loop-turn-budget-v1" },
    "kind": { "const": "turn-budget-ledger" },
    "runId": {
      "type": "string",
      "maxLength": 240,
      "pattern": ".*\\S.*"
    },
    "enabled": { "type": "boolean" },
    "maxSlots": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        { "type": "null" }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "spends": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/spend" }
    },
    "ledgerHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": { "const": true }
        },
        "required": ["enabled"]
      },
      "then": {
        "properties": {
          "maxSlots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "else": {
        "properties": {
          "maxSlots": { "type": "null" },
          "spends": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "turnKey",
        "durableReceiptHash",
        "acceptedResultHash",
        "spentAt",
        "spendHash"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "turnKey": { "$ref": "#/$defs/hash" },
        "durableReceiptHash": { "$ref": "#/$defs/hash" },
        "acceptedResultHash": { "$ref": "#/$defs/hash" },
        "spentAt": { "type": "string", "format": "date-time" },
        "spendHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
