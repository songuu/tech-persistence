{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-persistence.local/schemas/agent-loop/runtime-promotion-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "descriptorId", "descriptorHash", "canaryReceiptHash", "eligible", "route", "writerEligible", "checks", "receiptHash"],
  "properties": {
    "version": { "const": "external-runtime-promotion-v1" },
    "descriptorId": { "type": "string" },
    "descriptorHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "canaryReceiptHash": {
      "anyOf": [
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "eligible": { "type": "boolean" },
    "route": { "enum": ["shadow", "read-only"] },
    "writerEligible": { "const": false },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered", "observedCapability", "fixedCanaryPassed", "canaryReceiptBound", "zeroEffects", "identityMatched", "environmentAllowed", "explicitPromotion"],
      "properties": {
        "registered": { "type": "boolean" },
        "observedCapability": { "type": "boolean" },
        "fixedCanaryPassed": { "type": "boolean" },
        "canaryReceiptBound": { "type": "boolean" },
        "zeroEffects": { "type": "boolean" },
        "identityMatched": { "type": "boolean" },
        "environmentAllowed": { "type": "boolean" },
        "explicitPromotion": { "type": "boolean" }
      }
    },
    "receiptHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
