{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-persistence.local/schemas/self-learning/behavior-episode.schema.json",
  "title": "Self Learning Behavior Episode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "revision", "project_id", "session_id", "task_ref", "event_refs", "event_set_hash", "goals", "actions", "results", "explicit_feedback", "weak_signals", "counterexamples", "evidence_refs", "final_disposition", "verification_status", "completeness", "status", "created_at"],
  "properties": {
    "schema_version": { "const": "self-learning-behavior-episode-v1" },
    "episode_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "task_ref": { "type": ["string", "null"] },
    "event_refs": { "type": "array", "items": { "$ref": "#/$defs/eventRef" }, "minItems": 1 },
    "event_set_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "goals": { "type": "array", "items": { "$ref": "#/$defs/goalRef" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/actionRef" } },
    "results": { "type": "array", "items": { "$ref": "#/$defs/resultRef" } },
    "explicit_feedback": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "weak_signals": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "counterexamples": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "final_disposition": { "type": "string", "enum": ["accepted", "rejected", "reverted", "superseded", "unknown"] },
    "verification_status": { "type": "string", "enum": ["verified", "failed", "not_run", "unknown"] },
    "completeness": { "type": "string", "enum": ["complete", "incomplete", "unassigned"] },
    "status": { "type": "string", "enum": ["open", "closed", "needs_review"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$" },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_hash", "event_type", "signal_strength", "source", "source_assurance", "status", "final_disposition", "evidence_refs", "occurred_at", "counterexample", "retry", "invalid_call", "verification_status"],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "event_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "event_type": { "type": "string", "enum": ["user.prompt", "user.feedback", "user.correction", "user.approval", "tool.request", "tool.result", "task.result", "system.lifecycle"] },
        "signal_strength": { "type": "string", "enum": ["explicit", "weak", "inferred"] },
        "source": { "type": "string", "enum": ["claude_hook", "codex_cli", "codex_mcp", "agent_loop", "legacy_unverified"] },
        "source_assurance": { "type": "string", "enum": ["verified", "explicit", "observed", "legacy_unverified"] },
        "status": { "type": "string", "enum": ["observed", "succeeded", "failed", "blocked", "unknown"] },
        "final_disposition": { "type": "string", "enum": ["accepted", "rejected", "reverted", "superseded", "unknown"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "occurred_at": { "type": "string", "format": "date-time" },
        "counterexample": { "type": "boolean" },
        "retry": { "type": "boolean" },
        "invalid_call": { "type": "boolean" },
        "verification_status": { "type": "string", "enum": ["verified", "failed", "not_run", "unknown"] }
      }
    },
    "categoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_hash", "event_type"],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "event_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "event_type": { "type": "string" }
      }
    },
    "goalRef": {
      "allOf": [
        { "$ref": "#/$defs/categoryRef" },
        { "properties": { "event_type": { "const": "user.prompt" } } }
      ]
    },
    "actionRef": {
      "allOf": [
        { "$ref": "#/$defs/categoryRef" },
        { "properties": { "event_type": { "const": "tool.request" } } }
      ]
    },
    "resultRef": {
      "allOf": [
        { "$ref": "#/$defs/categoryRef" },
        { "properties": { "event_type": { "enum": ["tool.result", "task.result"] } } }
      ]
    }
  }
}
